# ===== docker-compose 配置（开发默认；复制为 .env 后可修改）=====
# 注意：改 MYSQL_ROOT_PASSWORD / MYSQL_DATABASE 时，务必同步修改 MYSQL_DSN 中的对应部分！

# --- MySQL ---
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=go_meteor_cms
# 把 MySQL 暴露到宿主机的端口（默认不暴露，避免与本地 MySQL 的 3306 冲突）。
# 如需从宿主机用 GUI 直连，取消注释并改为 3306 或 3307，
# 同时取消 docker-compose.yml 里 mysql.ports 的注释。
# MYSQL_PORT=3306

# --- Redis（缓存 / 登录限流 / 全局踢人）---
REDIS_PORT=6379

# --- API 对外端口 ---
API_PORT=8888

# --- 容器内服务间连接（固定使用 compose 服务名，一般无需改动）---
MYSQL_DSN=root:123456@tcp(mysql:3306)/go_meteor_cms?parseTime=True&loc=Local
REDIS_HOST=redis:6379
WEB_DIST=/app/web/dist

# --- 容器构建镜像源（可选；默认走官方源，受限网络可改用镜像源）---
# NPM_REGISTRY=https://registry.npmmirror.com/
# GOPROXY=https://goproxy.cn,direct
